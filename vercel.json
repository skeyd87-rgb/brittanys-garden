{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://brittanys-garden-skeyd87.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/init.json", "destination": "https://brittanys-garden-skeyd87.firebaseapp.com/__/firebase/init.json" }
  ],
  "headers": [
    {
      "source": "/__/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
